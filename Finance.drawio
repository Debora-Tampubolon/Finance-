        <mxCell id="pwvBuZZOsnlDVYhLp-rC-29" parent="1" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shape=image;fontSize=13;spacing=0;strokeOpacity=0;rounded=1;absoluteArcSize=1;arcSize=9;strokeWidth=1.5;image=https://images.lucid.app/images/77b31015-1466-4d7f-a05c-dc9027cc7933/content;imageAspect=0;lucidId=XPs0zS3X6R4c;" value="" vertex="1">
