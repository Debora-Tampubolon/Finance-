        <mxCell id="pwvBuZZOsnlDVYhLp-rC-30" parent="1" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;fontSize=50;fontColor=#e81313;fontStyle=1;align=left;spacing=3.8;strokeOpacity=100;fillOpacity=100;rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#ffffff;strokeWidth=1.5;lucidId=WPs0-d04pGtS;" value="??" vertex="1">
